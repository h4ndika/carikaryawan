<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="referrer" content="no-referrer">
  <title>Posts - Photo Scraper Admin</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      background: #f5f7fa;
      min-height: 100vh;
    }

    .navbar {
      background: white;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      padding: 16px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .navbar h1 {
      font-size: 20px;
      color: #333;
    }

    .navbar-user {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .navbar-user span {
      color: #666;
      font-size: 14px;
    }

    .btn-logout {
      padding: 8px 16px;
      background: #dc3545;
      color: white;
      text-decoration: none;
      border-radius: 6px;
      font-size: 14px;
      transition: background 0.3s;
    }

    .btn-logout:hover {
      background: #c82333;
    }

    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 24px;
    }

    .page-header {
      margin-bottom: 24px;
    }

    .page-header h2 {
      font-size: 28px;
      color: #333;
      margin-bottom: 8px;
    }

    .page-header p {
      color: #666;
      font-size: 14px;
    }

    .filter-panel {
      background: white;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      padding: 24px;
      margin-bottom: 24px;
    }

    .filter-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .filter-header h3 {
      font-size: 16px;
      color: #333;
      font-weight: 600;
    }

    .filter-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      margin-bottom: 16px;
    }

    .filter-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .filter-group label {
      font-size: 13px;
      font-weight: 500;
      color: #555;
    }

    .filter-group select,
    .filter-group input {
      padding: 10px 12px;
      border: 2px solid #e0e0e0;
      border-radius: 8px;
      font-size: 14px;
      transition: border-color 0.3s;
      background: white;
    }

    .filter-group select:focus,
    .filter-group input:focus {
      outline: none;
      border-color: #667eea;
    }

    .filter-actions {
      display: flex;
      gap: 12px;
      justify-content: flex-end;
    }

    .btn-filter {
      padding: 10px 24px;
      background: #667eea;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.3s;
    }

    .btn-filter:hover {
      background: #5568d3;
    }

    .btn-reset {
      padding: 10px 24px;
      background: #6c757d;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.3s;
    }

    .btn-reset:hover {
      background: #5a6268;
    }

    .active-filters {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 16px;
    }

    .filter-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      background: #e3f2fd;
      color: #1976d2;
      border-radius: 16px;
      font-size: 13px;
    }

    .filter-tag button {
      background: none;
      border: none;
      color: #1976d2;
      cursor: pointer;
      font-size: 16px;
      line-height: 1;
      padding: 0;
    }

    .table-container {
      background: white;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      overflow: hidden;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    thead {
      background: #f8f9fa;
    }

    th {
      padding: 16px;
      text-align: left;
      font-size: 13px;
      font-weight: 600;
      color: #666;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 2px solid #e9ecef;
    }

    td {
      padding: 16px;
      border-bottom: 1px solid #e9ecef;
      font-size: 14px;
      color: #333;
    }

    tr:last-child td {
      border-bottom: none;
    }

    tbody tr:hover {
      background: #f8f9fa;
    }

    .post-title {
      font-weight: 500;
      color: #333;
      margin-bottom: 4px;
    }

    .post-meta {
      font-size: 12px;
      color: #999;
    }

    .post-thumbnail {
      width: 60px;
      height: 60px;
      border-radius: 8px;
      object-fit: cover;
      background: #f0f0f0;
    }

    .badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 500;
    }

    .badge-published {
      background: #d4edda;
      color: #155724;
    }

    .badge-draft {
      background: #fff3cd;
      color: #856404;
    }

    .btn-scrape {
      padding: 8px 16px;
      background: #667eea;
      color: white;
      border: none;
      border-radius: 6px;
      font-size: 13px;
      cursor: pointer;
      transition: background 0.3s;
    }

    .btn-scrape:hover {
      background: #5568d3;
    }

    .btn-scrape:disabled {
      background: #ccc;
      cursor: not-allowed;
    }

    .btn-view {
      padding: 8px 16px;
      background: #28a745;
      color: white;
      text-decoration: none;
      border-radius: 6px;
      font-size: 13px;
      transition: background 0.3s;
      display: inline-block;
    }

    .btn-view:hover {
      background: #218838;
    }

    .action-buttons {
      display: flex;
      gap: 8px;
    }

    .pagination {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 24px;
    }

    .pagination a {
      padding: 8px 16px;
      background: white;
      border: 1px solid #ddd;
      color: #333;
      text-decoration: none;
      border-radius: 6px;
      font-size: 14px;
      transition: all 0.3s;
    }

    .pagination a:hover {
      background: #667eea;
      color: white;
      border-color: #667eea;
    }

    .pagination a.active {
      background: #667eea;
      color: white;
      border-color: #667eea;
    }

    .loading {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0,0,0,0.5);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 9999;
    }

    .loading.active {
      display: flex;
    }

    .loading-content {
      background: white;
      padding: 24px 40px;
      border-radius: 12px;
      text-align: center;
    }

    .spinner {
      border: 4px solid #f3f3f3;
      border-top: 4px solid #667eea;
      border-radius: 50%;
      width: 40px;
      height: 40px;
      animation: spin 1s linear infinite;
      margin: 0 auto 16px;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    .alert {
      padding: 12px 16px;
      border-radius: 8px;
      margin-bottom: 16px;
      font-size: 14px;
    }

    .alert-success {
      background: #d4edda;
      color: #155724;
      border: 1px solid #c3e6cb;
    }

    .alert-error {
      background: #f8d7da;
      color: #721c24;
      border: 1px solid #f5c6cb;
    }
  </style>
</head>
<body>
  <nav class="navbar">
    <h1>📸 Photo Scraper Admin</h1>
    <div class="navbar-user">
      <span>👤 <%= user.name %></span>
      <a href="/logout" class="btn-logout">Logout</a>
    </div>
  </nav>

  <div class="container">
    <div class="page-header">
      <h2>Daftar Post</h2>
      <p>Total <%= total %> post • Halaman <%= currentPage %> dari <%= totalPages %></p>
    </div>

    <!-- Filter Panel -->
    <div class="filter-panel">
      <div class="filter-header">
        <h3>🔍 Filter Post</h3>
      </div>

      <form method="GET" action="/" id="filterForm">
        <input type="hidden" name="page" value="1">
        
        <div class="filter-grid">
          <!-- Status Foto -->
          <div class="filter-group">
            <label for="photo_status">Status Foto</label>
            <select name="photo_status" id="photo_status">
              <option value="">Semua</option>
              <option value="<=1" <%= filters.photo_status === '<=1' ? 'selected' : '' %>>Foto ≤ 1 (Kurang)</option>
              <option value=">1" <%= filters.photo_status === '>1' ? 'selected' : '' %>>Foto > 1 (Cukup)</option>
            </select>
          </div>

          <!-- Status Post -->
          <div class="filter-group">
            <label for="status">Status Post</label>
            <select name="status" id="status">
              <option value="">Semua</option>
              <option value="published" <%= filters.status === 'published' ? 'selected' : '' %>>Published</option>
              <option value="draft" <%= filters.status === 'draft' ? 'selected' : '' %>>Draft</option>
            </select>
          </div>

          <!-- Category -->
          <div class="filter-group">
            <label for="category_id">Kategori</label>
            <select name="category_id" id="category_id">
              <option value="">Semua Kategori</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>" <%= filters.category_id == cat.id ? 'selected' : '' %>><%= cat.name %></option>
              <% }) %>
            </select>
          </div>

          <!-- Province -->
          <div class="filter-group">
            <label for="province_id">Provinsi</label>
            <select name="province_id" id="province_id">
              <option value="">Semua Provinsi</option>
              <% provinces.forEach(prov => { %>
                <option value="<%= prov.id %>" <%= filters.province_id == prov.id ? 'selected' : '' %>><%= prov.name %></option>
              <% }) %>
            </select>
          </div>

          <!-- City -->
          <div class="filter-group">
            <label for="city_id">Kota</label>
            <select name="city_id" id="city_id">
              <option value="">Semua Kota</option>
              <% cities.forEach(city => { %>
                <option value="<%= city.id %>" <%= filters.city_id == city.id ? 'selected' : '' %>><%= city.name %></option>
              <% }) %>
            </select>
          </div>

          <!-- Date From -->
          <div class="filter-group">
            <label for="date_from">Dari Tanggal</label>
            <input type="date" name="date_from" id="date_from" value="<%= filters.date_from %>">
          </div>

          <!-- Date To -->
          <div class="filter-group">
            <label for="date_to">Sampai Tanggal</label>
            <input type="date" name="date_to" id="date_to" value="<%= filters.date_to %>">
          </div>
        </div>

        <div class="filter-actions">
          <button type="button" class="btn-reset" onclick="resetFilters()">Reset Filter</button>
          <button type="submit" class="btn-filter">Terapkan Filter</button>
        </div>
      </form>

      <!-- Active Filters Display -->
      <% 
        const activeFilters = [];
        if (filters.photo_status) activeFilters.push({ key: 'photo_status', label: 'Status Foto: ' + (filters.photo_status === '<=1' ? '≤ 1' : '> 1') });
        if (filters.status) activeFilters.push({ key: 'status', label: 'Status: ' + filters.status });
        if (filters.category_id) {
          const cat = categories.find(c => c.id == filters.category_id);
          if (cat) activeFilters.push({ key: 'category_id', label: 'Kategori: ' + cat.name });
        }
        if (filters.province_id) {
          const prov = provinces.find(p => p.id == filters.province_id);
          if (prov) activeFilters.push({ key: 'province_id', label: 'Provinsi: ' + prov.name });
        }
        if (filters.city_id) {
          const city = cities.find(c => c.id == filters.city_id);
          if (city) activeFilters.push({ key: 'city_id', label: 'Kota: ' + city.name });
        }
        if (filters.date_from) activeFilters.push({ key: 'date_from', label: 'Dari: ' + filters.date_from });
        if (filters.date_to) activeFilters.push({ key: 'date_to', label: 'Sampai: ' + filters.date_to });
      %>
      
      <% if (activeFilters.length > 0) { %>
        <div class="active-filters">
          <% activeFilters.forEach(filter => { %>
            <span class="filter-tag">
              <%= filter.label %>
              <button onclick="removeFilter('<%= filter.key %>')" title="Hapus filter">×</button>
            </span>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div id="alertContainer"></div>

    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th style="width: 80px;">Foto</th>
            <th>Judul Post</th>
            <th style="width: 150px;">Kategori</th>
            <th style="width: 150px;">Lokasi</th>
            <th style="width: 100px;">Jumlah Foto</th>
            <th style="width: 100px;">Status</th>
            <th style="width: 200px;">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% posts.forEach(post => { %>
            <tr>
              <td>
                <% if (post.thumbnail) { %>
                  <img src="<%= post.thumbnail %>" alt="<%= post.title %>" class="post-thumbnail" onerror="this.style.display='none'">
                <% } else { %>
                  <div class="post-thumbnail"></div>
                <% } %>
              </td>
              <td>
                <div class="post-title"><%= post.title %></div>
                <div class="post-meta">ID: <%= post.id %> • <%= new Date(post.created_at).toLocaleDateString('id-ID') %></div>
              </td>
              <td><%= post.category_name || '-' %></td>
              <td>
                <div><%= post.city_name || '-' %></div>
                <div class="post-meta"><%= post.province_name || '' %></div>
              </td>
              <td><strong><%= post.images_count %></strong> foto</td>
              <td>
                <% if (post.status === 'published') { %>
                  <span class="badge badge-published">Published</span>
                <% } else { %>
                  <span class="badge badge-draft">Draft</span>
                <% } %>
              </td>
              <td>
                <div class="action-buttons">
                  <button class="btn-scrape" onclick="scrapePhotos(<%= post.id %>, this)">Scrape Foto</button>
                  <a href="/posts/<%= post.id %>/photos" class="btn-view">Lihat Foto</a>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (totalPages > 1) { %>
      <div class="pagination">
        <% if (currentPage > 1) { %>
          <a href="/?page=<%= currentPage - 1 %>">← Previous</a>
        <% } %>
        
        <% for (let i = 1; i <= totalPages; i++) { %>
          <% if (i === currentPage) { %>
            <a href="/?page=<%= i %>" class="active"><%= i %></a>
          <% } else if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) { %>
            <a href="/?page=<%= i %>"><%= i %></a>
          <% } else if (i === currentPage - 3 || i === currentPage + 3) { %>
            <span>...</span>
          <% } %>
        <% } %>
        
        <% if (currentPage < totalPages) { %>
          <a href="/?page=<%= currentPage + 1 %>">Next →</a>
        <% } %>
      </div>
    <% } %>
  </div>

  <div class="loading" id="loading">
    <div class="loading-content">
      <div class="spinner"></div>
      <p>Sedang scraping foto...</p>
    </div>
  </div>

  <script>
    function showAlert(message, type) {
      const alertContainer = document.getElementById('alertContainer');
      const alert = document.createElement('div');
      alert.className = `alert alert-${type}`;
      alert.textContent = message;
      alertContainer.appendChild(alert);
      
      setTimeout(() => {
        alert.remove();
      }, 5000);
    }

    async function scrapePhotos(postId, button) {
      if (!confirm('Yakin ingin scrape foto untuk post ini? Foto lama akan dihapus.')) {
        return;
      }

      const loading = document.getElementById('loading');
      loading.classList.add('active');
      button.disabled = true;

      try {
        const response = await fetch(`/posts/${postId}/scrape-photos`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
        });

        const data = await response.json();

        if (data.success) {
          showAlert(data.message, 'success');
          setTimeout(() => {
            window.location.reload();
          }, 1500);
        } else {
          showAlert(data.message, 'error');
          button.disabled = false;
        }
      } catch (error) {
        showAlert('Terjadi kesalahan: ' + error.message, 'error');
        button.disabled = false;
      } finally {
        loading.classList.remove('active');
      }
    }

    function resetFilters() {
      window.location.href = '/';
    }

    function removeFilter(filterKey) {
      const url = new URL(window.location.href);
      url.searchParams.delete(filterKey);
      url.searchParams.set('page', '1');
      window.location.href = url.toString();
    }
  </script>
</body>
</html>
