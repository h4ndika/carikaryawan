# Apify API Configuration
APIFY_TOKEN=your_apify_token_here

# Apify Actor Configuration
APIFY_ACTOR_ID=compass/crawler-google-places

# Export Configuration
# Format: json, xlsx, csv, or multiple (comma-separated: json,xlsx,csv)
EXPORT_FORMAT=json,xlsx

# Output Directory
OUTPUT_DIR=./output

# Scraping Options
MAX_CRAWLED_PLACES=100
LANGUAGE=id
COUNTRY_CODE=id

# Optional: Custom User Agent
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Optional: Proxy Configuration
# PROXY_URLS=http://proxy1.example.com:8080,http://proxy2.example.com:8080

# Account Creator Options (for automated account creation)
# TEMP_MAIL_PROVIDER=tempmail.plus
# ACCOUNT_PASSWORD=YourSecurePassword123!
