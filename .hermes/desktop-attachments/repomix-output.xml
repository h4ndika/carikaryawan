                                <span class="detail-label">Website:</span>
                                <span class="detail-val" id="detail-place-website">-</span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">Alamat:</span>
                                <span class="detail-val" id="detail-place-address">-</span>
