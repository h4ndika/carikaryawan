<file path="public/style.css">
/* ─── VARIABLES & RESET ───────────────────────────────────────── */
:root {
    --bg:         #0f1117;
    --bg-raised:  #181b24;
    --bg-card:    #1e2130;
    --bg-surface: #252838;
    --border:     #2d3148;
    --border-lit: #3d4260;

    --text:       #e2e5f0;
    --text-muted: #8891b0;
    --text-dim:   #5a6382;

    --indigo:     #6366f1;
    --indigo-dk:  #4f46e5;
    --indigo-glo: rgba(99,102,241,.18);
    --emerald:    #10b981;
    --emerald-glo:rgba(16,185,129,.16);
    --rose:       #ef4444;
    --rose-glo:   rgba(239,68,68,.14);
    --amber:      #f59e0b;
    --amber-glo:  rgba(245,158,11,.14);
    --sky:        #38bdf8;

    --radius:     10px;
    --radius-sm:  6px;
    --radius-lg:  14px;
    --shadow:     0 2px 12px rgba(0,0,0,.35);
    --shadow-lg:  0 8px 32px rgba(0,0,0,.5);
    --transition: .2s cubic-bezier(.4,0,.2,1);
}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

@font-face {
    font-family: 'Inter';
    font-display: swap;
    src: local('Inter'), local('Inter-Regular');
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
}

/* ─── HEADER ──────────────────────────────────────────────────── */
.header {
    background: linear-gradient(135deg, var(--bg-raised) 0%, #141826 100%);
    border-bottom: 1px solid var(--border);
    padding: 1rem 1.5rem;
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(12px);
}
.header-content {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
}
.header-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
}
.logo {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
}
.version {
    color: var(--indigo);
    font-weight: 800;
}

/* ─── BADGES ──────────────────────────────────────────────────── */
.badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border-radius: 50px;
    white-space: nowrap;
}
.badge-primary   { background: var(--indigo-glo); color: var(--indigo); border: 1px solid rgba(99,102,241,.3); }
.badge-success   { background: var(--emerald-glo); color: var(--emerald); border: 1px solid rgba(16,185,129,.3); }
.badge-warning   { background: var(--amber-glo); color: var(--amber); border: 1px solid rgba(245,158,11,.3); }
.badge-danger    { background: var(--rose-glo); color: var(--rose); border: 1px solid rgba(239,68,68,.3); }
.badge-neutral   { background: rgba(136,145,176,.12); color: var(--text-muted); border: 1px solid rgba(136,145,176,.2); }

/* ─── STATS BAR ───────────────────────────────────────────────── */
.stats-bar {
    display: flex;
    gap: 0.25rem;
}
.stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.4rem 1rem;
    min-width: 100px;
}
.stat-label {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    font-weight: 600;
}
.stat-value {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--indigo);
    font-variant-numeric: tabular-nums;
}

/* ─── NAV TABS ────────────────────────────────────────────────── */
.nav-tabs {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    padding: 0 1.5rem;
    gap: 0.25rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 80px;
    z-index: 90;
}
.tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.25rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: var(--transition);
    white-space: nowrap;
}
.tab-btn:hover {
    color: var(--text);
    background: rgba(255,255,255,.03);
}
.tab-btn.active {
    color: var(--indigo);
    border-bottom-color: var(--indigo);
}
.tab-icon { font-size: 1rem; }

/* ─── MAIN LAYOUT ─────────────────────────────────────────────── */
.main-content {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1.25rem 1.5rem 3rem;
}
.tab-content {
    display: none;
    animation: fadeIn .3s ease;
}
.tab-content.active { display: block; }

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
}

/* ─── CARDS ────────────────────────────────────────────────────── */
.card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    margin-bottom: 1rem;
    transition: var(--transition);
}
.card:hover {
    border-color: var(--border-lit);
}
.card-full {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 220px);
}
.card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
}
.card-title {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
}
.card-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
}

/* ─── SCRAPER LAYOUT ──────────────────────────────────────────── */
.scraper-layout {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 1rem;
    align-items: start;
}
@media (max-width: 1024px) {
    .scraper-layout { grid-template-columns: 1fr; }
}

/* ─── FORM ELEMENTS ───────────────────────────────────────────── */
.form-group {
    margin-bottom: 1rem;
}
.form-group label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.4rem;
}
.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
}
.input, .select {
    width: 100%;
    padding: 0.6rem 0.85rem;
    font-size: 0.85rem;
    font-family: inherit;
    color: var(--text);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    outline: none;
    transition: var(--transition);
}
.input:focus, .select:focus {
    border-color: var(--indigo);
    box-shadow: 0 0 0 3px var(--indigo-glo);
}
.input::placeholder { color: var(--text-dim); }
.input-sm, .select-sm {
    padding: 0.4rem 0.65rem;
    font-size: 0.78rem;
}

/* Autocomplete Dropdown */
.autocomplete-wrapper {
    position: relative;
    width: 100%;
}
.autocomplete-dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    max-height: 260px;
    overflow-y: auto;
    background: var(--bg-card);
    border: 1px solid var(--border-lit);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lg);
    z-index: 100;
    display: none;
}
.autocomplete-dropdown.open {
    display: block;
    animation: fadeIn 0.15s ease;
}
@keyframes fadeIn {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
}
.autocomplete-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.85rem;
    font-size: 0.82rem;
    color: var(--text);
    cursor: pointer;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    transition: background 0.12s ease;
}
.autocomplete-item:last-child {
    border-bottom: none;
}
.autocomplete-item:hover, .autocomplete-item.selected {
    background: rgba(99, 102, 241, 0.15);
    color: #fff;
}
.autocomplete-item-type {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    background: var(--bg-surface);
    color: var(--text-muted);
}
.autocomplete-item.selected .autocomplete-item-type {
    background: rgba(99, 102, 241, 0.3);
    color: var(--indigo);
}

/* Slider */
.slider {
    width: 100%;
    -webkit-appearance: none;
    appearance: none;
    height: 6px;
    border-radius: 3px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    outline: none;
    transition: var(--transition);
    cursor: pointer;
}
.slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--indigo);
    border: 2px solid var(--bg-card);
    cursor: pointer;
    box-shadow: 0 0 0 3px var(--indigo-glo);
}
.slider::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--indigo);
    border: 2px solid var(--bg-card);
    cursor: pointer;
}

/* Toggle */
.toggle-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-size: 0.82rem;
    color: var(--text);
}
.toggle {
    -webkit-appearance: none;
    appearance: none;
    width: 36px;
    height: 20px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    position: relative;
    cursor: pointer;
    transition: var(--transition);
    flex-shrink: 0;
}
.toggle::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    top: 2px;
    left: 2px;
    background: var(--text-muted);
    border-radius: 50%;
    transition: var(--transition);
}
.toggle:checked {
    background: var(--indigo);
    border-color: var(--indigo);
}
.toggle:checked::after {
    left: 18px;
    background: #fff;
}

/* Format Pills */
.format-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
}
.pill-checkbox input { display: none; }
.pill {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: 50px;
    border: 1px solid var(--border);
    background: var(--bg-surface);
    color: var(--text-muted);
    cursor: pointer;
    transition: var(--transition);
    user-select: none;
}
.pill:hover { border-color: var(--border-lit); }
.pill-checkbox input:checked + .pill {
    background: var(--indigo-glo);
    border-color: rgba(99,102,241,.4);
    color: var(--indigo);
}

/* ─── BUTTONS ─────────────────────────────────────────────────── */
.btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1rem;
    font-size: 0.8rem;
    font-weight: 600;
    font-family: inherit;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: var(--transition);
    white-space: nowrap;
}
.btn:active { transform: scale(.97); }

.btn-primary {
    background: var(--indigo);
    color: #fff;
    border-color: var(--indigo-dk);
}
.btn-primary:hover {
    background: var(--indigo-dk);
    box-shadow: 0 4px 16px var(--indigo-glo);
}
.btn-success {
    background: rgba(16,185,129,.15);
    color: var(--emerald);
    border-color: rgba(16,185,129,.3);
}
.btn-success:hover { background: rgba(16,185,129,.25); }
.btn-danger {
    background: var(--rose-glo);
    color: var(--rose);
    border-color: rgba(239,68,68,.3);
}
.btn-danger:hover { background: rgba(239,68,68,.25); }
.btn-secondary {
    background: var(--bg-surface);
    color: var(--text-muted);
    border-color: var(--border);
}
.btn-secondary:hover { color: var(--text); border-color: var(--border-lit); }
.btn-sm { padding: 0.35rem 0.65rem; font-size: 0.72rem; }

.btn-large {
    width: 100%;
    justify-content: center;
    padding: 0.85rem;
    font-size: 0.9rem;
    border-radius: var(--radius);
    margin-top: 0.25rem;
}
.btn-icon { font-size: 1rem; flex-shrink: 0; }

.btn-loading {
    pointer-events: none;
    opacity: .7;
}
.btn-loading .btn-icon { animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* ─── TERMINAL ────────────────────────────────────────────────── */
.terminal {
    background: #0d0f14;
    border: 1px solid #1a1d28;
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    font-family: 'Fira Code', 'Cascadia Code', 'Consolas', 'Courier New', monospace;
    font-size: 0.72rem;
    line-height: 1.65;
    color: #8891b0;
    max-height: 340px;
    overflow-y: auto;
    overflow-x: hidden;
    word-break: break-all;
    scroll-behavior: smooth;
}
.terminal-full {
    flex: 1;
    max-height: none;
    min-height: 400px;
}
.terminal-sm {
    max-height: 200px;
    margin-top: 0.75rem;
}

/* Custom scrollbar */
.terminal::-webkit-scrollbar { width: 5px; }
.terminal::-webkit-scrollbar-track { background: transparent; }
.terminal::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
.terminal::-webkit-scrollbar-thumb:hover { background: var(--border-lit); }

.log-line { padding: 1px 0; }
.log-time { color: var(--text-dim); margin-right: 0.5rem; }
.log-info    { color: var(--sky); }
.log-success { color: var(--emerald); }
.log-warn    { color: var(--amber); }
.log-error   { color: var(--rose); }

/* ─── PROGRESS BAR ────────────────────────────────────────────── */
.progress-bar {
    height: 4px;
    background: var(--bg-surface);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 0.75rem;
}
.progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--indigo), var(--emerald));
    border-radius: 4px;
    transition: width .5s ease;
}

/* ─── METRICS ─────────────────────────────────────────────────── */
.metrics {
    display: flex;
    gap: 1.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    margin-top: 0.75rem;
}
.metric { display: flex; gap: 0.35rem; align-items: center; }
.metric-label { font-size: 0.72rem; color: var(--text-dim); font-weight: 600; text-transform: uppercase; letter-spacing: .03em; }
.metric-value { font-size: 0.82rem; font-weight: 700; color: var(--text); }

/* ─── TABLES ──────────────────────────────────────────────────── */
.table-container {
    overflow-x: auto;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
}
.data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.78rem;
}
.data-table thead {
    position: sticky;
    top: 0;
    z-index: 2;
}
.data-table th {
    background: var(--bg-surface);
    color: var(--text-muted);
    font-weight: 700;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.65rem 0.85rem;
    text-align: left;
    white-space: nowrap;
    border-bottom: 1px solid var(--border);
}
.data-table td {
    padding: 0.6rem 0.85rem;
    border-bottom: 1px solid rgba(45,49,72,.4);
    color: var(--text);
    vertical-align: middle;
}
.data-table tbody tr {
    transition: var(--transition);
}
.data-table tbody tr:hover {
    background: rgba(99,102,241,.04);
}

/* Token masking */
.token-cell {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: 'Fira Code', monospace;
    font-size: 0.72rem;
}
.token-text {
    max-width: 140px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.token-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.85rem;
    opacity: 0.5;
    transition: var(--transition);
    padding: 2px;
}
.token-btn:hover { opacity: 1; }

/* Stars */
.stars { color: var(--amber); letter-spacing: 1px; font-size: 0.8rem; }
.stars-dim { color: var(--text-dim); }

/* ─── MODALS ──────────────────────────────────────────────────── */
.modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(0,0,0,.6);
    backdrop-filter: blur(6px);
    align-items: center;
    justify-content: center;
    padding: 2rem;
    animation: fadeIn .2s ease;
}
.modal.open { display: flex; }
.modal-content {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    width: 100%;
    max-width: 520px;
    max-height: 85vh;
    overflow-y: auto;
    box-shadow: var(--shadow-lg);
    animation: modalIn .3s cubic-bezier(.4,0,.2,1);
}
.modal-large .modal-content { max-width: 960px; }
@keyframes modalIn {
    from { opacity: 0; transform: translateY(16px) scale(.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
}
.modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
}
.modal-title { font-size: 0.95rem; font-weight: 700; }
.modal-close {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 1.5rem;
    cursor: pointer;
    line-height: 1;
    transition: var(--transition);
}
.modal-close:hover { color: var(--rose); }
.modal-body { padding: 1.25rem 1.5rem; }
.modal-body p { font-size: 0.82rem; color: var(--text-muted); margin-bottom: 1rem; }
.modal-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
}
.modal-content form { padding: 1.25rem 1.5rem; }

/* ─── STAT CARDS GRID ────────────────────────────────────────── */
.stats-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
}
.stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
}
.stat-card:hover {
    border-color: var(--border-lit);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
}
.stat-card-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
}
.stat-card-val {
    font-size: 1.45rem;
    font-weight: 800;
    line-height: 1;
}

/* ─── TOASTS ──────────────────────────────────────────────────── */
.toast-container {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 300;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}
.toast {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1rem;
    font-size: 0.8rem;
    font-weight: 500;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    animation: toastIn .35s cubic-bezier(.4,0,.2,1);
    max-width: 380px;
}
.toast-success { border-left: 3px solid var(--emerald); }
.toast-error   { border-left: 3px solid var(--rose); }
.toast-info    { border-left: 3px solid var(--indigo); }
.toast-warn    { border-left: 3px solid var(--amber); }
@keyframes toastIn {
    from { opacity: 0; transform: translateX(20px); }
    to   { opacity: 1; transform: translateX(0); }
}
.toast-exit {
    animation: toastOut .25s ease forwards;
}
@keyframes toastOut {
    to { opacity: 0; transform: translateX(30px); }
}

/* ─── ACTION CELL ─────────────────────────────────────────────── */
.action-btns {
    display: flex;
    gap: 0.3rem;
}
.action-btn {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 0.3rem 0.45rem;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.78rem;
    transition: var(--transition);
}
.action-btn:hover { color: var(--text); border-color: var(--border-lit); }
.action-btn.danger:hover { color: var(--rose); border-color: rgba(239,68,68,.4); }
.action-btn.success:hover { color: var(--emerald); border-color: rgba(16,185,129,.4); }

/* Download buttons */
.dl-btns {
    display: flex;
    gap: 0.25rem;
}
.dl-btn {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.25rem 0.45rem;
    border-radius: 4px;
    border: 1px solid var(--border);
    background: var(--bg-surface);
    color: var(--text-muted);
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: .04em;
    transition: var(--transition);
}
.dl-btn:hover { border-color: var(--indigo); color: #fff; background: var(--indigo); }
.dl-btn.dl-xlsx:hover { border-color: var(--emerald); background: var(--emerald); }
.dl-btn.dl-csv:hover  { border-color: var(--indigo); background: var(--indigo); }
.dl-btn.dl-json:hover { border-color: var(--amber); background: var(--amber); color: #000; }
.dl-btn.dl-xml:hover  { border-color: var(--rose); background: var(--rose); }

/* Clickable table rows */
.data-table-clickable tbody tr {
    cursor: pointer;
    transition: background 0.15s ease, transform 0.1s ease;
}
.data-table-clickable tbody tr:hover {
    background: rgba(99, 102, 241, 0.08) !important;
}

/* Modal Toolbar */
.modal-toolbar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
}

/* Place Detail Modal Grid */
.place-detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
}
@media (max-width: 860px) {
    .place-detail-grid { grid-template-columns: 1fr; }
}

.detail-info-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
}

.detail-section {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
}

.detail-section-title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
}

.detail-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 0.35rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    font-size: 0.82rem;
    gap: 1rem;
}
.detail-row:last-child { border-bottom: none; }
.detail-label { color: var(--text-muted); font-weight: 500; min-width: 90px; }
.detail-val { color: var(--text); font-weight: 600; text-align: right; word-break: break-word; }

.detail-text-box {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-muted);
    background: rgba(0, 0, 0, 0.2);
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    max-height: 140px;
    overflow-y: auto;
    word-break: break-word;
}

.facility-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
}
.facility-tag {
    font-size: 0.72rem;
    font-weight: 600;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: var(--emerald);
    padding: 0.25rem 0.55rem;
    border-radius: 9999px;
}

/* Photos Gallery Grid */
.detail-photos-col {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
    display: flex;
    flex-direction: column;
}

.photos-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 0.6rem;
    max-height: 520px;
    overflow-y: auto;
    padding-right: 0.25rem;
}
.photo-thumb-link {
    display: block;
    aspect-ratio: 4/3;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-card);
    transition: transform 0.2s ease, border-color 0.2s ease;
}
.photo-thumb-link:hover {
    transform: scale(1.04);
    border-color: var(--indigo);
}
.photo-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

/* Pagination Bar */
.pagination-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0 0.5rem;
    font-size: 0.82rem;
    color: var(--text-muted);
}
.pagination-controls {
    display: flex;
    gap: 0.5rem;
}

/* Helper colors */
.text-emerald { color: var(--emerald) !important; }
.text-indigo  { color: var(--indigo) !important; }
.text-rose    { color: var(--rose) !important; }
.text-amber   { color: var(--amber) !important; }
.text-muted   { color: var(--text-muted) !important; }

/* ─── EMPTY STATE ─────────────────────────────────────────────── */
.empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-dim);
}
.empty-state-icon { font-size: 2.5rem; margin-bottom: 0.75rem; }
.empty-state-text { font-size: 0.82rem; }

/* ─── SKELETON ────────────────────────────────────────────────── */
.skeleton {
    background: linear-gradient(90deg, var(--bg-surface) 25%, var(--border) 50%, var(--bg-surface) 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    border-radius: 4px;
    height: 14px;
}
@keyframes shimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
}

/* ─── RESPONSIVE ──────────────────────────────────────────────── */
@media (max-width: 768px) {
    .header-content { flex-direction: column; align-items: flex-start; }
    .stats-bar { width: 100%; overflow-x: auto; }
    .nav-tabs { overflow-x: auto; top: auto; position: relative; }
    .card-header { flex-direction: column; align-items: flex-start; }
    .card-actions { width: 100%; }
    .form-row { grid-template-columns: 1fr; }
    .modal-content { margin: 1rem; }
    .metrics { flex-wrap: wrap; }
}
